# === AI (Gemini) ===
# https://aistudio.google.com → Get API key → Create API key in new project
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# === Database (Supabase) ===
# 선택사항 — 없으면 dedup/피드백이 로컬 JSON으로 폴백
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...
# 구독자 테이블(subscribers, feedback_events, sent_items)용 service role 키. 없으면 SUPABASE_KEY 로 폴백
SUPABASE_SERVICE_KEY=

# === Telegram (1순위) ===
# 1. @BotFather → /newbot → 토큰 발급
# 2. 봇에게 /start 전송 후 @userinfobot 으로 본인 chat ID 확인
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# === Email (Resend, 2순위) ===
# 무료 플랜: onboarding@resend.dev 로만 발송 가능 (수신자 = Resend 가입 이메일)
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=your@email.com
# 운영 알림(워크플로 실패, 품질 게이트) 수신자. 비우면 EMAIL_TO 로 폴백. 구독자 주소는 넣지 않는다
ALERT_EMAIL_TO=
# 발송 경로: resend(기본) | smtp
EMAIL_PROVIDER=resend
# SMTP 서버 호스트(EMAIL_PROVIDER=smtp 일 때만 쓴다)
SMTP_HOST=
# SMTP 포트. 587 은 STARTTLS(기본), 465 는 SSL
SMTP_PORT=587
# SMTP 로그인 계정
SMTP_USER=
# SMTP 로그인 비밀번호(Gmail 이면 앱 비밀번호)
SMTP_PASSWORD=

# === App ===
# Railway/Render 배포 후 실제 URL로 교체 (피드백 링크에 사용)
BASE_URL=http://localhost:8000

# === 배송 채널 ===
# "telegram" | "email" | "telegram,email"
DELIVERY_CHANNELS=discord

# Discord (hermes 봇 재사용) — 발송·피드백 수거의 정본 채널
# 필요 권한: View Channel / Send Messages / Read Message History /
#            Add Reactions / Create Polls
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# === Content Sources ===
# YouTube 채널 ID (쉼표 구분) — Tier 1
# 토스 SLASH(UC-ooeEMOToyByAC1WOQE8ew)·if(kakao)(UCwKk-EEF0gmsHJ5z3CVnRzA)는 채널이 삭제돼
# 토스 챌린저스(TMC 발표 다시보기)·kakao tech(if(kakao) 세션 VOD)로 교체 (2026-09-15)
YOUTUBE_CHANNELS=UCN4ZJl6nQpIBo-eRJZom4xA,UC-mOekGSesms0agFntnQang,UCdQF7F6hwjSpulj_fwB9iDQ,UCNrehnUq7Il-J7HQxrzp7CA

# RSS 피드 URL (쉼표 구분) — Tier 1
# The Batch(피드 404)·Data Elixir(피드 중단)는 제거 (2026-09-15)
RSS_FEEDS=https://toss.tech/rss.xml,https://medium.com/feed/daangn,https://tech.kakao.com/blog/feed/,https://d2.naver.com/d2.atom

# Stibee 뉴스레터 URL (쉼표 구분) — 비우면 DEFAULT_NEWSLETTERS 사용
NEWSLETTERS=

# === Settings ===
MAX_ITEMS_PER_DIGEST=3
RELEVANCE_THRESHOLD=7
LOG_LEVEL=INFO
# 링크 기사 본문 fetch (HN/RSS 요약만 있을 때 전문 확보). 기본 true.
FETCH_LINK_BODY=true

# === YouTube 수집 설정 ===
YT_FETCH_PER_CHANNEL=10
YT_NEW_PER_CHANNEL=3

# === 개인화 효과 측정 ===
# 구독자 선정에서 기준 선정(관심도 조정 없음) 아이템으로 바꿔 넣는 자리 수. 0 이면 끈다
EFFECT_HOLDOUT_SLOTS=1
# 실험 대상 자리가 기준 선정 쪽 아이템으로 나갈 확률(0~1)
EFFECT_HOLDOUT_RATE=0.5
# 구독자 메일의 원문 링크를 클릭 기록 페이지(go.html)로 돌릴지
TRACK_CLICKS=true

# === Dry Run ===
# true: Gemini/Telegram/이메일 호출 없이 파이프라인 흐름 검증
DRY_RUN=false
